    /* Basics */
body {
    margin: 0 !important;
    padding: 0;
    background-color: #ffffff;
	font-family: 'RobotoBold';
}
body,table,thead,tbody,tr,td,img {
	padding: 0;
	margin: 0;
	border: none;
	border-spacing: 0px;
	border-collapse: collapse;
	vertical-align: top;
}
div[style*="margin: 16px 0"] { 
    margin:0 !important;
}
h1, h2, h3, h4, h5, h6{ margin:0;}
p, a, td, .Poppins{font-family: 'Poppins', arial, sans-serif !important;}
.desktop-hide{
    display: none !important
}

@media(max-width: 767px){
    .maintable{
        width: 100% !important;
    }
    .relative{
        position: relative !important;
    }
    .spacepadding{
        width: 25px !important;
    }
    .mobilecolumn{
        display: block;
        width: 100% !important;
    }
    .hero-image{
        top: 52px !important;
        position: relative !important;
        right: -57px !important;
    }
    .mobilehide{
        display: none !important;
    }
    .fs-30{
        font-size: 30px !important;
        line-height: 38px !important
    }
}

</style>

</head>

